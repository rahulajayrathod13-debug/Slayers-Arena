// countdown ticking
function tickCountdowns(){
  document.querySelectorAll('[data-countdown]').forEach(box=>{
    const target = parseInt(box.dataset.countdown,10);
    let diff = Math.max(0, target - Date.now());
    const d = Math.floor(diff/86400000); diff -= d*86400000;
    const h = Math.floor(diff/3600000); diff -= h*3600000;
    const m = Math.floor(diff/60000); diff -= m*60000;
    const s = Math.floor(diff/1000);
    box.querySelector('.dd').textContent = String(d).padStart(2,'0');
    box.querySelector('.hh').textContent = String(h).padStart(2,'0');
    box.querySelector('.mm').textContent = String(m).padStart(2,'0');
    box.querySelector('.ss').textContent = String(s).padStart(2,'0');
  });
}
tickCountdowns();
